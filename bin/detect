#!/usr/bin/env bash
set -euo pipefail

BUILDPACK_NAME="Claude Code Environment"
BUILDPACK_VERSION="2.0.0"

detected=false

if [ -f ".claude-code-config.yml" ]; then
    echo "${BUILDPACK_NAME} ${BUILDPACK_VERSION}: .claude-code-config.yml found"
    detected=true
fi

if [ -f "${CNB_PLATFORM_DIR}/env/CLAUDE_CODE_ENABLED" ]; then
    enabled_value=$(cat "${CNB_PLATFORM_DIR}/env/CLAUDE_CODE_ENABLED")
    if [ "${enabled_value}" = "true" ]; then
        echo "${BUILDPACK_NAME} ${BUILDPACK_VERSION}: CLAUDE_CODE_ENABLED=true"
        detected=true
    fi
fi

if [ -d ".claude" ]; then
    echo "${BUILDPACK_NAME} ${BUILDPACK_VERSION}: .claude/ state directory found"
    detected=true
fi

if [ "${detected}" = "true" ]; then
    cat >> "${CNB_BUILD_PLAN_PATH}" <<TOML
[[provides]]
name = "claude-code"

[[requires]]
name = "claude-code"
TOML
    exit 0
fi

exit 100
